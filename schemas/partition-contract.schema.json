{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoMyRobotOS Partition Contract v1",
  "description": "Hypervisor-independent partition contract. Describes what a partition is allowed and required to do (execution, isolation, communication, startup, recovery). No backend-specific keys (xen_*, xtratum_*, xng_*, board aliases) are permitted; backend data belongs in the backend profile. Frozen with milestone M0.",
  "type": "object",
  "required": ["partition", "execution", "memory", "recovery"],
  "additionalProperties": false,
  "properties": {
    "partition": {
      "type": "object",
      "description": "Identity and semantic class of the partition.",
      "required": ["id", "name", "criticality", "trust_domain"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable, machine-unique partition identifier."
        },
        "name": { "type": "string", "minLength": 1 },
        "criticality": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Semantic class; drives how strictly the backend must realize the declared isolation semantics."
        },
        "trust_domain": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. flight, service, platform."
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["cpu_set", "scheduling"],
      "additionalProperties": false,
      "properties": {
        "cpu_set": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Cpus the partition may run on."
        },
        "scheduling": {
          "type": "object",
          "required": ["policy", "priority"],
          "additionalProperties": false,
          "properties": {
            "policy": { "type": "string", "minLength": 1, "description": "Target-agnostic scheduling policy name." },
            "priority": { "type": "integer", "minimum": 1 }
          }
        },
        "timing_budget": {
          "type": "object",
          "required": ["period_us", "budget_us"],
          "additionalProperties": false,
          "properties": {
            "period_us": { "type": "integer", "minimum": 1 },
            "budget_us": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "required": ["regions"],
      "additionalProperties": false,
      "properties": {
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "size", "permissions"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "size": { "type": "string", "pattern": "^[0-9]+(K|M|G)$" },
              "permissions": { "type": "string", "pattern": "^[rwxs]{1,4}$" }
            }
          }
        }
      }
    },
    "devices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownership": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Devices owned exclusively by this partition."
        }
      }
    },
    "interrupts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owned": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Interrupts owned by this partition; one interrupt is owned by at most one partition."
        }
      }
    },
    "dma": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permitted_regions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Memory region names this partition's DMA may touch (must reference memory.regions names)."
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "max_message_size", "max_rate_hz"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "max_message_size": { "type": "integer", "minimum": 1 },
              "max_rate_hz": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "startup": {
      "type": "object",
      "required": ["boot_artifact", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "boot_artifact": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "description": "Partition ids that must be started first."
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["image_identity", "secure_boot_required"],
      "additionalProperties": false,
      "properties": {
        "image_identity": { "type": "string", "pattern": "^[a-z0-9]+:[0-9a-f]{8,}$" },
        "secure_boot_required": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["watchdog", "restart_policy", "safe_state", "escalation_policy"],
      "additionalProperties": false,
      "properties": {
        "watchdog": { "type": "boolean" },
        "restart_policy": { "type": "string", "minLength": 1 },
        "safe_state": { "type": "string", "minLength": 1 },
        "escalation_policy": { "type": "string", "minLength": 1 }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string", "pattern": "^GMR-[A-Z]+-[A-Z0-9]+-[0-9]{3}$" }
    },
    "verification": {
      "type": "object",
      "required": ["required_tests"],
      "additionalProperties": false,
      "properties": {
        "required_tests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        }
      }
    }
  }
}